# Optional. The API still starts without this value; AI enrichment is then reported as unavailable.
GROQ_API_KEY=your_groq_api_key_here

# Current Groq chat model; change without code changes when your account enables another supported model.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2

# Optional public-web research via Tavily. Without it, competitor claims remain explicitly unavailable.
TAVILY_API_KEY=your_tavily_api_key_here

# Required for Person 3 text generation and preferred Person 4 AI evaluation.
GEMINI_API_KEY=your_gemini_api_key_here
# Set this to a model enabled for your Google AI account.
GEMINI_MODEL=gemini-2.5-flash

# Optional: enable image creation by sending generate_image=true to /api/v1/workflow/run.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_token_here
# Cloudflare-hosted FLUX model; override only with another compatible Workers AI image model.
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
